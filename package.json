{
  "name": "color-contrast-kit",
  "version": "1.0.0",
  "description": "Check color contrast compatibility (WCAG 2.1 + APCA), suggest fixes, and validate design-token palettes.",
  "keywords": [
    "accessibility",
    "a11y",
    "contrast",
    "wcag",
    "apca",
    "color",
    "design-tokens"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "color-contrast": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "culori": "^4.0.1"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
